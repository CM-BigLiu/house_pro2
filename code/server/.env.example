# 后端服务配置
NODE_ENV=development
PORT=3000

# 数据库
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=house_pro

# JWT
JWT_SECRET=house_pro_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d
# access token 有效期（默认 2h）
JWT_ACCESS_EXPIRES_IN=2h
# refresh token 有效期（默认 7d）
JWT_REFRESH_EXPIRES_IN=7d
# refresh token 独立签名密钥（生产必填，勿与 JWT_SECRET 相同）
JWT_REFRESH_SECRET=house_pro_jwt_refresh_secret_change_in_production

# 敏感字段加密密钥（32 字节 base64，生产必填；可用 `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"` 生成）
FIELD_ENCRYPTION_KEY=

# 初始超管账号
ADMIN_MOBILE=super_admin
ADMIN_PASSWORD=123456
