og_path":"","prepare_status":"ok","tasks_by_phase":{"test":"## 1. dev.backend:test - dev 测试先行\n\n<!-- on_conditions_eval:\n     stage=dev (常驻, 无 on_conditions)\n     track=backend (常驻, 无 on_conditions)\n-->\n\n- [ ] 1.1 为 `AuthService` 编写单元测试：`login` 返回双令牌（access + refresh）；`refresh` 校验 token_type + DB 账态；`logout` 置 revoked；覆盖 V-backend-1~4 的后端断言（refresh 落库 / hash 存储 / 停用联动吊销 / token_type 区分）","dev":"## 2. dev.backend:dev - 实现开发\n\n<!-- on_conditions_eval:\n     stage=dev (常驻, 无 on_conditions)\n     track=backend (常驻, 无 on_conditions)\n-->\n\n- [ ] 2.1 新增 `refresh-token.entity.ts`（RefreshToken entity：userId/tokenHash/status/expiresAt/revokedAt）\n- [ ] 2.2 `AuthModule` 注册 `TypeOrmModule.forFeature([RefreshToken])` + JWT 双 secret（access/refresh 独立密钥 + 独立 expiresIn）\n- [ ] 2.3 `AuthService.login` 改为签发 access（token_type=access, 2h）+ refresh（token_type=refresh, 7d），refresh 落库 sha256 hash\n- [ ] 2.4 新增 `AuthService.refresh`：校验 token_type=refresh + DB 账态（active 且未过期）→ 签发新 access\n- [ ] 2.6 `AuthController` 新增 `POST /auth/refresh`、`POST /auth/logout`（`@Public()` + 独立校验）\n- [ ] 2.7 `JwtAuthGuard` 增加 `token_type === 'access'` 校验，拒绝 refresh token 误当 access 使用","review":"## 3. dev.backend:review - 静态代码审查\n\n<!-- on_conditions_eval:\n     stage=dev (常驻, 无 on_conditions)\n     track=backend (常驻, 无 on_conditions)\n-->\n\n- [ ] 3.1 review agent 读 design.md + tasks.md + .pg/code-review/code-review.yaml 细则\n- [ ] 3.2 review agent 对 git diff feat/pg/auth-token-refresh 做静态审查\n- [ ] 3.3 review agent 输出 review_score + p0_failures 到本 section 对应的 review 报告（路径由 dispatch 注入）\n- [ ] 3.4 score < pass_threshold → escalate 至 fix-review；score ≥ pass_threshold → completed → 进入 verify","verify":"## 4. dev.backend:verify - dev 集成验证\n\n<!-- on_conditions_eval:\n     stage=dev (常驻, 无 on_conditions)\n     track=backend (常驻, 无 on_conditions)\n-->\n\n- [ ] 4.1 执行 lint（runner 通过 modules 注入命令）\n- [ ] 4.2 执行测试（runner 通过 modules 注入命令）\n- [ ] 4.3 启动服务（如需）\n- [ ] 4.4 验证 V-backend-N：来自 design.md（N 由 design.md 决定，非章节号）\n\n  **Evidence 要求**（verify agent 在验证报告中产出，gate agent 据此评审）：\n  - 每个 V-* 必须有对应的原始输出（curl 响应 / 命令行输出 / 日志片段）\n  - SKIP 的 V-* 必须注明豁免理由\n  - 测试结果（Tests run: N, Failures: 0, Errors: 0）必须有日志摘要","gate":"## 5. dev.backend:gate - dev 门控审查\n\n<!-- on_conditions_eval:\n     stage=dev (常驻, 无 on_conditions)\n     track=backend (常驻, 无 on_conditions)\n-->\n\n- 无"},"commands":[],"timeout_seconds":1800,"code_review_enabled":true,"code_review_profiles":[],"code_review_profile":"","code_review_languages":["typescript"],"verify_enabled":true,"gate_enabled":true,"verify_failure_mode":"fail-fast","scenario_max_fix_cycles":null,"scenario_last_restart_attempt":-1},"dev.frontend":{"track_id":"dev.frontend","bare":"frontend","label":"前端 track：web 模块 TDRVG 循环（无测试命令，build+lint 承担门禁）","status":"pending","started_at":null,"completed_at":null,"modules":["web"],"max_fail_retries":3,"max_fix_retries":5,"max_gate_fix_retries":2,"max_review_fix_retries":3,"phases":{"test":{"status":"completed","attempt":1,"started_at":null,"completed_at":null,"agent":null,"report_path":"D:\\04-profile\\test\\house_pro4\\house_pro2\\.pg\\changes\\auth-token-refresh\\2-build\\006-dev.frontend-test-result.json","summary":"TDD 红 phase：5 个 vitest 用例全部失败（生产代码未实现），符合预期","tasks_marked":[],"current_cycle":1},"dev":{"status":"completed","attempt":1,"started_at":null,"completed_at":null,"agent":null,"report_path":"D:\\04-profile\\test\\house_pro4\\house_pro2\\.pg\\changes\\auth-token-refresh\\2-build\\007-dev.frontend-dev-result.json","summary":"dev.frontend 绿 phase：vitest 5/5 通过（V-frontend-1 刷新重放、并发单飞合并、refresh 失败清理）；npm run build 成功","tasks_marked":[],"current_cycle":1},"review":{"status":"completed","attempt":0,"started_at":null,"completed_at":null,"agent":null,"report_path":"D:\\04-profile\\test\\house_pro4\\house_pro2\\.pg\\changes\\auth-token-refresh\\2-build\\008-dev.frontend-review-result.json","summary":"review PASS: 5/6 检查项通过, review_score: 82.6, R-3 FAIL（非 P0, 建议抽取 clearAuthState action）","tasks_marked":[],"